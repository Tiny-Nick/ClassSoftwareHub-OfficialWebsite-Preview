{
  "name": "classsoftwarehub-official-website",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-only",
  "description": "ClassSoftwareHub 产品官网 —— 扁平极简 + 新拟物风格的门面站，分流至网页版清单、桌面版客户端与内置工具",
  "type": "module",
  "scripts": {
    "dev": "vite --host=0.0.0.0",
